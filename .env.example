# Polymarket Multi-Account Copy Trading Bot Configuration

# Your Wallet Configuration (REQUIRED)
FUNDER_ADDRESS=0xYourWalletAddress
PRIVATE_KEY=0xYourPrivateKey

# Automatic Updates Configuration
# Generate a Personal Access Token (classic) on GitHub with 'repo' scope
GITHUB_TOKEN=ghp_YourGitHubTokenHere

# Optional Settings
SIGNATURE_TYPE=1
BET_AMOUNT=2.0
DRY_RUN=True
DB_PATH=betting_history.db

# Note: Target accounts are now configured through the web GUI
# Go to http://localhost:5000 and use the "Add Account" button
