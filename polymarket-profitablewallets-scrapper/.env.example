# ── Wallet / Signing ──
METAMASK_PRIVATE_KEY=your_private_key_here

# ── Polymarket Builder API Credentials ──
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_PASSPHRASE=your_passphrase_here

# ── Builder Profile ──
POLYMARKET_BUILDER_PROFILE=your_profile_name
POLYMARKET_BUILDER_ADDRESS=your_wallet_address

# ── Scraping Settings ──
# How many top users to fetch from EACH category (OVERALL, POLITICS, SPORTS, CRYPTO, CULTURE)
LEADERBOARD_LIMIT=1000

# Minimum absolute total PNL in USD
MIN_PNL=10000

# Minimum total volume in USD
MIN_VOLUME=50000

# Maximum days since last trade (skip stale wallets)
MAX_INACTIVE_DAYS=7

# Maximum active positions (filter out market makers / bots)
MAX_ACTIVE_POSITIONS=50

# Minimum average trade size (filter out small high-frequency traders)
MIN_AVG_TRADE_SIZE=100

# Maximum average trades per day over their active lifespan (filter out high frequency drainers)
MAX_TRADES_PER_DAY=20

# Delay in seconds between continuous scrape cycles (default: 60)
CONTINUOUS_DELAY_SEC=5

# Max concurrent API requests to speed up scraping (default: 20)
CONCURRENCY=20

# Number of days to remember rejected wallets before checking them again (default: 7)
REJECTED_TTL_DAYS=7

# Output file path
OUTPUT_PATH=./output/profitable_wallets.json
REJECTED_PATH=./output/rejected_wallets.json
